{
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "sonnet",
  "statusLine": {
    "type": "command",
    "command": "sh ~/.claude/statusline-command.sh",
    "padding": 0,
    "refreshInterval": 2
  },
  "modelSettings": {
    "claude-sonnet-5": {
      "effortLevel": "medium"
    }
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "superpowers@anthropic-plugin-directory": true
  },
  "theme": "dark",
  "editorMode": "vim",
  "effortLevel": "medium",
  "tui": "fullscreen",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true
}
